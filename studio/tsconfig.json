{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@anchor/core": [
        "../packages/anchor-core/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "remotion.config.ts",
    "../packages/anchor-core/src"
  ]
}
